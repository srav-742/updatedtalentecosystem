# ========================================
# Hire1Percent Frontend Configuration
# ========================================

# Base API URL pointing to the API Gateway (or Local Backend)
VITE_API_URL=http://localhost:4000/api

# Razorpay Client-Side Key ID
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Public API Gateway client identifier; private credentials must remain server-side.
VITE_CLIENT_ID=hire1percent_web_client

# Google Analytics 4 (GA4) Measurement ID
VITE_GA_MEASUREMENT_ID=G-GHYJZVBMB4
